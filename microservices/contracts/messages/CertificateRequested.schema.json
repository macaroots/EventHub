{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://event-hub.local/contracts/messages/CertificateRequested.schema.json",
  "title": "CertificateRequested",
  "description": "registration → certificate (futuro, ADR 003). Um por participante com presença em ao menos uma atividade, ao receber EventEnded. Traz todos os dados do certificado.",
  "allOf": [{ "$ref": "envelope.schema.json" }],
  "type": "object",
  "required": ["type", "requestId", "eventId", "userId", "participantName", "eventName", "activities", "totalWorkload"],
  "properties": {
    "type": { "const": "CertificateRequested" },
    "requestId": { "type": "string", "pattern": "^[^:]+:[^:]+$", "description": "<eventId>:<userId>. Chave de idempotência do serviço de certificados." },
    "eventId": { "$ref": "envelope.schema.json#/$defs/uuid" },
    "userId": { "$ref": "envelope.schema.json#/$defs/uuid" },
    "participantName": { "type": ["string", "null"], "description": "Hoje é o username (identity ainda não tem nome completo)." },
    "eventName": { "$ref": "envelope.schema.json#/$defs/nonEmpty" },
    "activities": {
      "type": "array",
      "minItems": 1,
      "description": "Atividades com presença, ordenadas por data.",
      "items": {
        "type": "object",
        "required": ["activityId", "name", "workload", "date"],
        "properties": {
          "activityId": { "$ref": "envelope.schema.json#/$defs/uuid" },
          "name": { "type": "string" },
          "workload": { "type": ["number", "null"], "minimum": 0, "description": "Horas (1 casa). null se a atividade não tem horário." },
          "date": { "type": "string", "format": "date" }
        }
      }
    },
    "totalWorkload": { "type": "number", "minimum": 0, "description": "Soma das cargas horárias (null conta 0)." }
  },
  "examples": [{ "type": "CertificateRequested", "messageId": "0b9c6c1e-3f0a-4d38-9d2e-6f1c2a7b8e01", "occurredAt": "2026-11-06T13:00:00.000Z", "requestId": "3c2b1a00-0000-4000-8000-00000000e001:6a1f0c2e-1b2c-4d3e-8f40-5a6b7c8d9e01", "eventId": "3c2b1a00-0000-4000-8000-00000000e001", "userId": "6a1f0c2e-1b2c-4d3e-8f40-5a6b7c8d9e01", "participantName": "ana", "eventName": "Semana de TI", "activities": [{ "activityId": "4d3c2b00-0000-4000-8000-00000000a001", "name": "Oficina de Node", "workload": 3, "date": "2026-11-10" }], "totalWorkload": 3 }]
}
