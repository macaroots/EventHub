{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://event-hub.local/contracts/messages/CertificateRequested.schema.json",
  "title": "CertificateRequested",
  "description": "registration → certificate (ADR 003). Um por participante com presença em ao menos uma atividade, ao receber EventEnded. Traz todos os dados do certificado.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "type": {
      "const": "CertificateRequested"
    },
    "source": {
      "const": "registration"
    },
    "data": {
      "type": "object",
      "required": [
        "requestId",
        "eventId",
        "participantId",
        "participantName",
        "eventName",
        "eventDate",
        "activities",
        "totalWorkload"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "pattern": "^[^:]+:[^:]+$",
          "description": "<eventId>:<participantId>. Chave de idempotência do serviço de certificados."
        },
        "eventId": {
          "$ref": "envelope.schema.json#/$defs/uuid"
        },
        "participantId": {
          "$ref": "envelope.schema.json#/$defs/uuid",
          "description": "userId (identity) do participante."
        },
        "participantName": {
          "$ref": "envelope.schema.json#/$defs/nonEmpty",
          "description": "Nome do participante (UserRegistered/UserUpdated)."
        },
        "eventName": {
          "$ref": "envelope.schema.json#/$defs/nonEmpty"
        },
        "eventDate": {
          "type": "string",
          "format": "date",
          "description": "Data da primeira atividade com presença (YYYY-MM-DD)."
        },
        "activities": {
          "type": "array",
          "minItems": 1,
          "description": "Atividades com presença, ordenadas por data.",
          "items": {
            "type": "object",
            "required": [
              "activityId",
              "name",
              "workload",
              "date"
            ],
            "properties": {
              "activityId": {
                "$ref": "envelope.schema.json#/$defs/uuid"
              },
              "name": {
                "type": "string"
              },
              "workload": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "description": "Horas (1 casa). null se a atividade não tem horário."
              },
              "date": {
                "type": "string",
                "format": "date"
              }
            }
          }
        },
        "totalWorkload": {
          "type": "number",
          "minimum": 0,
          "description": "Soma das cargas horárias (null conta 0)."
        }
      }
    }
  },
  "examples": [
    {
      "id": "0b9c6c1e-3f0a-4d38-9d2e-6f1c2a7b8e01",
      "type": "CertificateRequested",
      "source": "registration",
      "time": "2026-11-06T13:00:00.000Z",
      "data": {
        "requestId": "3c2b1a00-0000-4000-8000-00000000e001:6a1f0c2e-1b2c-4d3e-8f40-5a6b7c8d9e01",
        "eventId": "3c2b1a00-0000-4000-8000-00000000e001",
        "participantId": "6a1f0c2e-1b2c-4d3e-8f40-5a6b7c8d9e01",
        "participantName": "Ana Souza",
        "eventName": "Semana de TI",
        "eventDate": "2026-11-10",
        "activities": [
          {
            "activityId": "4d3c2b00-0000-4000-8000-00000000a001",
            "name": "Oficina de Node",
            "workload": 3,
            "date": "2026-11-10"
          }
        ],
        "totalWorkload": 3
      }
    }
  ]
}
