# HTTP
PORT=3001
NODE_ENV=development

# PostgreSQL (identity-db)
DATABASE_URL=postgresql://identity_user:identity_pass@localhost:5432/identity_db

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Service-to-service auth
INTERNAL_API_TOKEN=change-me-to-another-random-string

# CORS – origin of the web front-end
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
