<p><a href="/registrations/<%= registration.id %>">← Inscrição</a></p>
<section>
    <h2>Pagamento</h2>
    <p>
        <%= registration.event?.name ?? '' %> / <%= registration.activity?.name ?? '' %>.
        <%= payment.description %>: R$ <%= payment.amount.toFixed(2) %>.
    </p>
<% if (payment.status == 'pending') { %>
    <form method="post" action="/payments/<%= payment.id %>">
        <label><span>Comprovante:</span><input name="receipt" required></label>
        <button>Pagar</button>
    </form>
    <p><small>Gateway simulado: o comprovante <code>deny</code> é recusado.</small></p>
<% } else { %>
    <p>Pagamento <%= payment.status == 'paid' ? 'aprovado' : 'recusado' %>.</p>
<% } %>
</section>
