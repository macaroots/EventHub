<% const base = `/organizers/activities/${activity.id}/registrations`;
   const filters = [['', 'Todas'], ['pending', 'Pendentes'], ['awaiting_payment', 'Aguardando pagamento'], ['waitlisted', 'Fila de espera'], ['confirmed', 'Confirmadas'], ['canceled', 'Canceladas']]; %>
<div class="page-container">
<p class="breadcrumb"><a href="/organizers/activities/<%= activity.id %>">Atividade</a><% if (event) { %> <span>›</span> <a href="/organizers/events/<%= event.id %>">Evento</a><% } %></p>
<section class="page-heading">
    <span class="eyebrow">GESTÃO</span>
    <h1>Inscrições: <%= activity.name %></h1>
    <% if (event) { %><p class="muted">Evento: <%= event.name %> · <%= event.status %></p><% } %>
    <p class="stats-line">
        Ocupação: <%= activity.occupation %>/<%= activity.capacity %> vagas
        (<%= activity.confirmedOccupation %> confirmadas, <%= counts.pending %> pendentes, <%= counts.awaiting_payment %> aguardando pagamento;
        <%= counts.waitlisted %> na fila de espera, <%= counts.canceled %> canceladas).
        Preço: R$ <%= activity.price.toFixed(2) %>.
    </p>
    <p>Comparecimento: <%= activity.present %> de <%= activity.confirmedOccupation %> confirmadas. <a class="btn-secondary" href="/organizers/activities/<%= activity.id %>/checkin">Abrir check-in</a></p>
    <div class="filter-links">
<% for (const [value, label] of filters) { %>
        <% if (value == status) { %><strong><%= label %></strong><% } else { %><a href="<%= base %><%= value ? `?status=${value}` : '' %>"><%= label %></a><% } %>
<% } %>
    </div>
 </section>
 <section class="data-panel">
<% if (!registrations.length) { %>
    <p class="empty-state">Nenhuma inscrição.</p>
<% } else { %>
    <table class="hub-table">
        <tr><th>Participante</th><th>Status</th><th>Pendências / motivo</th><th>Ações</th></tr>
<% for (const r of registrations) { const pending = r.requirements.filter(q => !q.fulfilled); %>
        <tr>
            <td><%= r.participant?.name ?? r.userId %></td>
            <td><%- include('../registrations/status', { status: r.status }) %><% if (r.attendance) { %>, presente<% } %></td>
            <td>
<% if (r.status == 'canceled') { %>
                <%= r.reasons.join('; ') %>
<% } else { if (r.status == 'awaiting_payment') { %>
                <div>Pagamento: R$ <%= r.payment.amount.toFixed(2) %></div>
<% } for (const q of pending) { %>
                <div>
                    <%- include('../registrations/requirement', { requirement: q }) %>
<% if (q.type == 'age verification') { %>
                    <form method="post" action="/organizers/registrations/<%= r.id %>/requirements/<%= q.id %>/fulfill" style="display:inline">
                        <input type="hidden" name="activityId" value="<%= activity.id %>">
                        <button class="btn-secondary">aprovar</button>
                    </form>
<% } %>
                </div>
<% } } %>
            </td>
            <td>
<% if (r.status != 'canceled') { %>
                <form method="post" action="/organizers/registrations/<%= r.id %>/cancel" onsubmit="return confirm('Cancelar a inscrição?')">
                    <input type="hidden" name="activityId" value="<%= activity.id %>">
                    <input name="reason" placeholder="Motivo">
                    <button class="btn-link-danger">cancelar</button>
                </form>
<% } %>
            </td>
        </tr>
<% } %>
    </table>
<% } %>
</section>
</div>
