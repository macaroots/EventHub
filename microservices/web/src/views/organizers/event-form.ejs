<div class="hub-form-group">
    <label for="eventName">Nome do evento</label>
    <input
        id="eventName"
        name="name"
        class="hub-form-input"
        placeholder="Ex: Fórum de Inovação e Tecnologia 2026"
        value="<%= event.name ?? '' %>"
        required
    >
</div>

<div class="hub-form-group">
    <label for="eventInfo">Informações / Descrição</label>
    <textarea
        id="eventInfo"
        name="information"
        class="hub-form-textarea"
        placeholder="Descreva detalhes, objetivos e programação geral..."
        rows="4"
    ><%= event.information ?? '' %></textarea>
</div>

<div class="hub-form-group">
    <label for="eventLocation">Local do evento</label>
    <input id="eventLocation" name="location" class="hub-form-input" placeholder="Ex: Auditório central ou Online" value="<%= event.location ?? '' %>">
</div>

<div class="form-grid-two">
    <div class="hub-form-group">
        <label for="startDate">Data de início</label>
        <input
            id="startDate"
            name="startDate"
            type="date"
            class="hub-form-input"
            value="<%= event.startDate?.slice(0, 10) ?? '' %>"
        >
    </div>

    <div class="hub-form-group">
        <label for="endDate">Data de término</label>
        <input
            id="endDate"
            name="endDate"
            type="date"
            class="hub-form-input"
            value="<%= event.endDate?.slice(0, 10) ?? '' %>"
        >
    </div>
</div>
