<% const base = `/organizers/activities/${activity.id}/checkin`;
   const open = checkIn.status == 'open'; %>
<p><a href="/organizers/activities/<%= activity.id %>/registrations">← Inscrições</a><% if (event) { %> · <a href="/organizers/events/<%= event.id %>">Evento</a><% } %></p>
<section>
    <h2>Check-in: <%= activity.name %></h2>
    <p>Presentes: <strong><%= present %></strong> de <%= confirmed %> confirmados.</p>
<% if (open) { %>
    <p>Check-in aberto desde <%= dateTime(checkIn.openedAt) %>. Código para mostrar na sala:</p>
    <p class="checkin-code"><%= checkIn.code %></p>
    <p><a href="<%= base %>?display=1">Mostrar em tela cheia</a></p>
    <form method="post" action="<%= base %>/open" style="display:inline" onsubmit="return confirm('Gerar um código novo? O atual deixa de valer.')"><button>Gerar código novo</button></form>
    <form method="post" action="<%= base %>/close" style="display:inline"><button>Fechar check-in</button></form>
<% } else if (event?.status == 'published') { %>
    <p>Check-in fechado.</p>
    <form method="post" action="<%= base %>/open"><button>Abrir check-in</button></form>
<% } else { %>
    <p>Evento cancelado: sem check-in.</p>
<% } %>
</section>
<section>
    <h3>Inscritos confirmados</h3>
<% if (!attendees.length) { %>
    <p>Nenhum inscrito confirmado.</p>
<% } else { %>
    <table>
        <tr><th>Participante</th><th>Presença</th></tr>
<% for (const a of attendees) { %>
        <tr>
            <td><%= a.participant?.username ?? a.userId %><% if (a.status != 'confirmed') { %> <small>(inscrição <%- include('../registrations/status', { status: a.status }) %>)</small><% } %></td>
            <td>
<% if (a.attendance) { %>
                presente desde <%= dateTime(a.attendance.checkedInAt) %> (<%= a.attendance.method == 'code' ? 'código' : 'marcada pelo organizador' %>)
<% } else if (event?.status == 'published') { %>
                <form method="post" action="/organizers/registrations/<%= a.registrationId %>/checkin" style="display:inline">
                    <input type="hidden" name="activityId" value="<%= activity.id %>">
                    <button>marcar presença</button>
                </form>
<% } else { %>
                ausente
<% } %>
            </td>
        </tr>
<% } %>
    </table>
<% } %>
</section>
