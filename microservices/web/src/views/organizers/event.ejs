<% const base = `/organizers/events/${event.id}`; const canceled = event.status == 'canceled'; const draft = event.status == 'draft'; const published = event.status == 'published'; const ended = event.status == 'ended'; %>
<div class="page-container">
<p class="breadcrumb"><a href="/organizers/events">Meus eventos</a> <span>›</span> <%= event.name %></p>
<section class="page-heading event-heading">
    <span class="eyebrow">VISÃO GERAL DO EVENTO</span>
    <h1><%= event.name %></h1>
    <span class="status-pill status-<%= event.status %>"><%= event.status %></span>
    <% if (canceled) { %><p class="notice notice-error">Cancelado: <%= event.cancelReason %></p><% } %>
    <% if (ended) { %><p class="notice notice-info">Encerrado: os certificados de quem teve presença foram solicitados.</p><% } %>
    <% if (!draft) { %><p class="muted">Evento e atividades não mudam depois de publicados.</p><% } %>
</section>
<section class="data-panel form-panel">
    <form method="post" action="<%= base %>" class="hub-form">
        <fieldset <%= draft ? '' : 'disabled' %>>
            <%- include('event-form', { event }) %>
            <button class="btn-primary">Salvar alterações</button>
        </fieldset>
    </form>
    <% if (draft) { %>
    <form method="post" action="<%= base %>/publish" class="inline-form"><button class="btn-primary">Publicar evento</button></form>
    <% } %>
    <% if (published) { %>
    <form method="post" action="<%= base %>/end" onsubmit="return confirm('Encerrar o evento? Inscrições e check-in fecham e os certificados são solicitados. Corrija as presenças antes.')">
        <button class="btn-secondary">Encerrar evento</button> <small>depois do término; solicita os certificados</small>
    </form>
    <% } %>
    <% if (draft || published) { %>
    <form method="post" action="<%= base %>/cancel">
        <input name="reason" placeholder="Motivo" required>
        <button class="btn-danger">Cancelar evento</button>
    </form>
    <% } %>
    <% if (draft || canceled) { %>
    <form method="post" action="<%= base %>/delete" onsubmit="return confirm('Apagar o evento e suas atividades?')">
        <button class="btn-danger">Apagar evento</button>
    </form>
    <% } %>
</section>
<section class="data-panel">
    <div class="panel-heading"><h2>Atividades</h2><% if (draft) { %><a class="btn-primary" href="<%= base %>/activities/new">+ Nova atividade</a><% } %></div>
    <table class="hub-table">
        <tr><th>Nome</th><th>Início</th><th>Vagas</th><th>Preço</th><th></th></tr>
<% for (const activity of event.activities) { %>
        <tr>
            <td><a href="/organizers/activities/<%= activity.id %>"><%= activity.name %></a></td>
            <td><%= activity.startsAt ?? '' %></td>
            <td><%= activity.capacity %></td>
            <td><%= activity.price %></td>
            <td><% if (!draft) { %><a href="/organizers/activities/<%= activity.id %>/registrations">inscrições</a> · <a href="/organizers/activities/<%= activity.id %>/checkin">check-in</a><% } %></td>
        </tr>
<% } %>
    </table>
</section>
<section class="data-panel">
    <div class="panel-heading"><h2>Organizadores</h2></div>
    <ul class="clean-list">
<% for (const organizer of organizers) { %>
        <li>
            <%= organizer.name %><% if (organizer.email) { %> &lt;<%= organizer.email %>&gt;<% } %><% if (organizer.id == event.createdBy) { %> (criador)<% } else if (!canceled) { %>
            <form method="post" action="<%= base %>/organizers/<%= organizer.id %>/delete" style="display:inline">
                <button class="btn-link-danger">remover</button>
            </form><% } %>
        </li>
<% } %>
    </ul>
    <% if (!canceled) { %>
    <form method="post" action="<%= base %>/organizers">
        <input name="email" type="email" placeholder="e-mail" required>
        <button class="btn-primary">Adicionar organizador</button>
    </form>
    <% } %>
</section>
</div>
