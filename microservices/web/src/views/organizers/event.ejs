<% const base = `/organizers/events/${event.id}`; const canceled = event.status == 'canceled'; %>
<p><a href="/organizers/events">← Meus eventos</a></p>
<section>
    <h2><%= event.name %> <small>(<%= event.status %>)</small></h2>
    <% if (canceled) { %><p>Cancelado: <%= event.cancelReason %></p><% } %>
    <form method="post" action="<%= base %>">
        <fieldset <%= canceled ? 'disabled' : '' %>>
            <%- include('event-form', { event }) %>
            <button>Salvar</button>
        </fieldset>
    </form>
    <% if (event.status == 'draft') { %>
    <form method="post" action="<%= base %>/publish"><button>Publicar</button></form>
    <% } %>
    <% if (!canceled) { %>
    <form method="post" action="<%= base %>/cancel">
        <input name="reason" placeholder="Motivo" required>
        <button>Cancelar evento</button>
    </form>
    <% } %>
    <% if (event.status != 'published') { %>
    <form method="post" action="<%= base %>/delete" onsubmit="return confirm('Apagar o evento e suas atividades?')">
        <button>Apagar evento</button>
    </form>
    <% } %>
</section>
<section>
    <h2>Atividades</h2>
    <table>
        <tr><th>Nome</th><th>Início</th><th>Vagas</th><th>Preço</th><th></th></tr>
<% for (const activity of event.activities) { %>
        <tr>
            <td><a href="/organizers/activities/<%= activity.id %>"><%= activity.name %></a></td>
            <td><%= activity.startsAt ?? '' %></td>
            <td><%= activity.capacity %></td>
            <td><%= activity.price %></td>
            <td><a href="/organizers/activities/<%= activity.id %>/registrations">inscrições</a></td>
        </tr>
<% } %>
    </table>
    <% if (!canceled) { %><p><a href="<%= base %>/activities/new">+ Nova atividade</a></p><% } %>
</section>
<section>
    <h2>Organizadores</h2>
    <ul>
<% for (const organizer of organizers) { %>
        <li>
            <%= organizer.username %><% if (organizer.id == event.createdBy) { %> (criador)<% } else { %>
            <form method="post" action="<%= base %>/organizers/<%= organizer.id %>/delete" style="display:inline">
                <button>remover</button>
            </form><% } %>
        </li>
<% } %>
    </ul>
    <form method="post" action="<%= base %>/organizers">
        <input name="username" placeholder="username" required>
        <button>Adicionar</button>
    </form>
</section>
