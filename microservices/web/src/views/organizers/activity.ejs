<% const isNew = !activity.id;
   const editable = isNew || activity.eventStatus == 'draft';
   const minimumAge = activity.rules.find(r => r.type == 'minimumAge')?.age ?? '';
   const action = isNew ? `/organizers/events/${activity.eventId}/activities` : `/organizers/activities/${activity.id}`; %>
<div class="page-container page-narrow">
<p class="breadcrumb"><a href="/organizers/events/<%= activity.eventId %>">Meus eventos</a> <span>›</span> Atividade</p>
<section class="page-heading">
    <span class="eyebrow">GESTÃO DO EVENTO</span>
    <h1><%= isNew ? 'Nova atividade' : activity.name %></h1>
    <% if (!editable) { %><p class="notice notice-info">Evento publicado: a atividade não pode mais ser alterada.</p><% } %>
</section>
<section class="data-panel form-panel">
    <form method="post" action="<%= action %>" class="hub-form">
        <fieldset <%= editable ? '' : 'disabled' %>>
        <div class="hub-form-group"><label for="activity-name">Nome</label><input id="activity-name" class="hub-form-input" name="name" required value="<%= activity.name ?? '' %>"></div>
        <div class="hub-form-group"><label for="activity-description">Descrição</label><textarea id="activity-description" class="hub-form-textarea" name="description"><%= activity.description ?? '' %></textarea></div>
        <div class="hub-form-group"><label for="activity-location">Local</label><input id="activity-location" class="hub-form-input" name="location" value="<%= activity.location ?? '' %>"></div>
        <div class="form-grid-two">
            <div class="hub-form-group"><label for="activity-start">Início</label><input id="activity-start" class="hub-form-input" type="datetime-local" name="startsAt" value="<%= activity.startsAt?.slice(0, 16) ?? '' %>"></div>
            <div class="hub-form-group"><label for="activity-end">Fim</label><input id="activity-end" class="hub-form-input" type="datetime-local" name="endsAt" value="<%= activity.endsAt?.slice(0, 16) ?? '' %>"></div>
            <div class="hub-form-group"><label for="activity-capacity">Vagas</label><input id="activity-capacity" class="hub-form-input" type="number" name="capacity" min="0" step="1" required value="<%= activity.capacity ?? '' %>"></div>
            <div class="hub-form-group"><label for="activity-price">Preço</label><input id="activity-price" class="hub-form-input" type="number" name="price" min="0" step="0.01" value="<%= activity.price ?? 0 %>"></div>
            <div class="hub-form-group"><label for="activity-age">Idade mínima</label><input id="activity-age" class="hub-form-input" type="number" name="minimumAge" min="1" step="1" value="<%= minimumAge %>"></div>
        </div>
        <button class="btn-primary"><%= isNew ? 'Criar atividade' : 'Salvar alterações' %></button>
        </fieldset>
    </form>
    <% if (!editable) { %>
    <div class="action-links"><a href="/organizers/activities/<%= activity.id %>/registrations">Gerenciar inscrições</a><a href="/organizers/activities/<%= activity.id %>/checkin">Check-in</a></div>
    <% } %>
    <% if (!isNew && editable) { %>
    <form method="post" action="/organizers/activities/<%= activity.id %>/delete" onsubmit="return confirm('Apagar a atividade?')">
        <input type="hidden" name="eventId" value="<%= activity.eventId %>">
        <button class="btn-danger">Apagar atividade</button>
    </form>
    <% } %>
</section>
</div>
