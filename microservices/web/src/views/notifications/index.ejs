<% const types = {
    PaymentRequested: { label: 'Pagamento pendente', tone: 'pending', icon: 'clock' },
    PaymentConfirmed: { label: 'Pagamento confirmado', tone: 'success', icon: 'check' },
    PaymentDenied: { label: 'Pagamento recusado', tone: 'danger', icon: 'cross' },
    PaymentExpired: { label: 'Prazo expirado', tone: 'danger', icon: 'clock' },
    PaymentCanceled: { label: 'Pagamento cancelado', tone: 'danger', icon: 'cross' },
    RegistrationCreated: { label: 'Inscrição recebida', tone: 'info', icon: 'document' },
    RegistrationConfirmed: { label: 'Inscrição confirmada', tone: 'success', icon: 'check' },
    RegistrationCanceled: { label: 'Inscrição cancelada', tone: 'danger', icon: 'cross' },
    EventCanceledNotice: { label: 'Evento cancelado', tone: 'danger', icon: 'calendar' },
    CheckInOpened: { label: 'Código de check-in', tone: 'checkin', icon: 'key' },
    CertificateIssued: { label: 'Certificado disponível', tone: 'success', icon: 'document' },
    CertificateDenied: { label: 'Certificado não disponível', tone: 'danger', icon: 'document' }
}; %>
<% const icons = {
    clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
    check: '<circle cx="12" cy="12" r="9"/><path d="m8 12 2.5 2.5L16 9"/>',
    cross: '<circle cx="12" cy="12" r="9"/><path d="m9 9 6 6m0-6-6 6"/>',
    document: '<path d="M6 3h8l4 4v14H6z"/><path d="M14 3v5h4M9 12h6M9 16h6"/>',
    calendar: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4m10-4v4M3 10h18m-12 3 6 5m0-5-6 5"/>',
    key: '<circle cx="8" cy="12" r="4"/><path d="M12 12h9m-3 0v3m-3-3v2"/>',
    bell: '<path d="M18 8a6 6 0 0 0-12 0c0 7-2 7-2 9h16c0-2-2-2-2-9M10 20h4"/>'
}; %>
<% const delivery = { sent:'E-mail enviado', logged:'Registrada', pending:'Aguardando envio', retry:'Tentando enviar', waiting_contact:'Aguardando contato', failed:'Falha no envio', skipped:'Substituída', sending:'Enviando' }; %>
<div class="page-container notifications-page">
    <p class="breadcrumb"><a href="/">Eventos</a> <span>›</span> Notificações</p>
    <header class="notifications-heading">
        <span class="eyebrow">MINHA CONTA</span>
        <h1>Minhas notificações</h1>
        <p>Acompanhe atualizações sobre suas inscrições, pagamentos e check-in.</p>
    </header>

    <% if (registrationId) { %><div class="notif-context"><span>Você está vendo as notificações desta compra.</span><a href="/notifications">Ver todas</a></div><% } %>
    <section class="notif-toolbar" aria-label="Filtrar notificações">
        <div class="notif-toolbar-copy"><h2>Suas atualizações</h2><p>Escolha um tipo para encontrar uma mensagem.</p></div>
        <form method="get" class="notifications-filter">
            <% if (registrationId) { %><input type="hidden" name="registrationId" value="<%= registrationId %>"><% } %>
            <label for="type">Tipo de notificação</label>
            <select id="type" name="type" class="hub-form-input" onchange="this.form.submit()">
                <option value="">Todas as notificações</option>
                <% for (const [value, type] of Object.entries(types)) { %><option value="<%= value %>" <%= filter === value ? 'selected' : '' %>><%= type.label %></option><% } %>
            </select>
            <noscript><button class="btn-primary" type="submit">Filtrar</button></noscript>
        </form>
    </section>

    <section class="notif-history" aria-labelledby="notification-history-title">
        <div class="notif-header"><div><h2 id="notification-history-title">Histórico</h2><p>Selecione uma notificação para ver a mensagem.</p></div><% if (!locals.notificationError) { %><span class="notif-count"><%= notifications.length %> <%= notifications.length === 1 ? 'mensagem exibida' : 'mensagens exibidas' %></span><% } %></div>
        <% if (locals.notificationError) { %>
            <div class="notif-empty"><div class="notif-empty-icon" aria-hidden="true">!</div><h3>Não foi possível carregar as notificações</h3><p>Tente novamente em instantes.</p></div>
        <% } else if (!notifications.length) { %>
            <div class="notif-empty"><div class="notif-empty-icon" aria-hidden="true">◇</div><h3><%= filter || registrationId ? 'Nenhuma mensagem encontrada' : 'Tudo tranquilo por aqui!' %></h3><p><%= filter || registrationId ? 'Não há notificações para esta seleção.' : 'Você ainda não possui notificações.' %></p></div>
        <% } else { %>
        <div class="notif-list">
            <% for (const item of notifications) { %>
                <% const type = types[item.event_type] || { label: 'Notificação', tone: 'info', icon: 'bell' }; %>
                <% const body = String(item.body ?? ''); const codeMatch = item.event_type === 'CheckInOpened' ? /Seu código é:\s*([A-Z0-9]{6})(?=\.|\s|$)/i.exec(body) : null; const codeStart = codeMatch ? codeMatch.index + codeMatch[0].lastIndexOf(codeMatch[1]) : -1; %>
                <details class="notif-card notif-card--<%= type.tone %>">
                    <summary class="notif-summary">
                        <span class="notif-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><%- icons[type.icon] %></svg></span>
                        <span class="notif-summary-text"><span class="notif-badge notif-badge--type"><%= type.label %></span><strong class="notif-subject"><%= item.subject %></strong></span>
                        <span class="notif-summary-end"><time class="notif-date" datetime="<%= new Date(item.created_at * 1000).toISOString() %>"><%= new Date(item.created_at * 1000).toLocaleString('pt-BR') %></time><span class="notif-expand"><span class="notif-open-label">Ver mensagem</span><span class="notif-close-label">Fechar mensagem</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m7 10 5 5 5-5"/></svg></span></span>
                    </summary>
                    <div class="notif-body">
                        <p class="notif-body-label">MENSAGEM</p>
                        <p class="notif-content"><% if (codeMatch) { %><%= body.slice(0, codeStart) %><mark class="notif-checkin-code"><%= codeMatch[1] %></mark><%= body.slice(codeStart + codeMatch[1].length) %><% } else { %><%= body %><% } %></p>
                        <div class="notif-footer"><div class="notif-delivery"><span class="notif-delivery-label">ENTREGA</span><span class="notif-badge notif-badge--delivery <%= item.status === 'sent' ? 'notif-badge--sent' : item.status === 'failed' ? 'notif-badge--failed' : '' %>"><%= delivery[item.status] || item.status %></span><% if (item.recipient) { %><span class="notif-email"><%= item.recipient %></span><% } %></div>
                            <% if (item.event_type === 'CertificateIssued') { %><a class="notif-action" href="/certificates">Ver certificados <span aria-hidden="true">→</span></a><% } %>
                            <% if (item.registration_id) { %><a class="notif-action" href="/registrations/<%= encodeURIComponent(item.registration_id) %>">Ver inscrição <span aria-hidden="true">→</span></a><% } %>
                        </div>
                    </div>
                </details>
            <% } %>
        </div>
        <% } %>
    </section>
</div>
