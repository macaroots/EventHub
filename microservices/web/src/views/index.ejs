<!-- Banner Hero com Busca estilo Protótipo -->
<section class="hero-banner">
    <div  class="hero-content">
        <span class="hero-tagline">ENCONTRE SEU PRÓXIMO EVENTO</span>
        <h1 class="hero-heading">Conhecimento e conexões começam aqui</h1>
        <p class="hero-subheading">Explore eventos acadêmicos e corporativos selecionados para você.</p>

        <!-- Barra de Busca e Filtros -->
        <div class="search-filter-card">
            <div class="search-input-group">
                <input type="text" class="search-field" placeholder="Buscar por nome do evento" id="eventSearchInput">
            </div>

            <select class="filter-select">
                <option value="">Qualquer data</option>
                <option value="today">Hoje</option>
                <option value="this_month">Este mês</option>
            </select>

            <select class="filter-select">
                <option value="">Todas categorias</option>
                <option value="tecnologia">Tecnologia</option>
                <option value="educacao">Educação</option>
                <option value="negocios">Negócios</option>
            </select>

            <select class="filter-select">
                <option value="">Todos os locais</option>
                <option value="presencial">Presencial</option>
                <option value="online">Online</option>
                <option value="hibrido">Híbrido</option>
            </select>

            <button class="btn-search" type="button" onclick="filterEvents()">Buscar</button>
        </div>
    </div>
</section>

<!-- Seção Próximos Eventos -->
<div class="container">
    <div class="events-section-header">
        <div>
            <h2 class="section-title">Próximos eventos</h2>
            <p class="section-subtitle"><%= events.length %> <%= events.length === 1 ? 'evento publicado' : 'eventos publicados' %></p>
        </div>
    </div>

    <% if (!events.length) { %>
        <div class="data-panel" style="text-align: center; padding: 3rem 1rem;">
            <p style="color: var(--text-muted); font-size: 1.1rem; margin-bottom: 1rem;">Nenhum evento publicado no momento.</p>
            <% if (locals.user) { %>
                <a href="/organizers/events" class="btn-primary">Criar primeiro evento</a>
            <% } %>
        </div>
    <% } else { %>
        <div class="events-grid" id="eventsGrid">
            <% for (const event of events) { 
                const d = event.startDate ? new Date(event.startDate) : new Date();
                const months = ['JAN','FEV','MAR','ABR','MAI','JUN','JUL','AGO','SET','OUT','NOV','DEZ'];
                const month = !isNaN(d.getTime()) ? months[d.getUTCMonth()] : 'SET';
                const day = !isNaN(d.getTime()) ? String(d.getUTCDate()).padStart(2, '0') : '18';
            %>
                <article class="event-card">
                    <div class="card-top-banner">
                        <span class="badge-tag">Geral</span>
                    </div>

                    <div class="card-body">
                        <div class="date-badge">
                            <span class="date-month"><%= month %></span>
                            <span class="date-day"><%= day %></span>
                        </div>

                        <div class="card-info">
                            <h3 class="card-title">
                                <a href="/events/<%= event.id %>"><%= event.name %></a>
                            </h3>

                            <div class="card-meta">
                                    <span>
                                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                                            <line x1="16" y1="2" x2="16" y2="6"/>
                                            <line x1="8" y1="2" x2="8" y2="6"/>
                                            <line x1="3" y1="10" x2="21" y2="10"/>
                                        </svg>
                                    <%= event.startDate?.slice(0, 10) ?? 'Data a definir' %><% if (event.endDate) { %> a <%= event.endDate.slice(0, 10) %><% } %></span>
                                <span>
                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
  <circle cx="12" cy="10" r="3"/>
</svg>
                                     <%= event.location || 'Local a definir' %></span>
                            </div>
                        </div>
                    </div>
                </article>
            <% } %>
        </div>
    <% } %>
</div>

<script>
function filterEvents() {
    const query = document.getElementById('eventSearchInput').value.toLowerCase();
    const cards = document.querySelectorAll('.event-card');
    cards.forEach(card => {
        const title = card.querySelector('.card-title').textContent.toLowerCase();
        card.style.display = title.includes(query) ? '' : 'none';
    });
}
document.getElementById('eventSearchInput')?.addEventListener('keyup', (e) => {
    if (e.key === 'Enter') filterEvents();
});
</script>
