<section>
    <h2>Próximos eventos</h2>
    <main>
<% for (const event of events) { %>
        <article>
            <h3><%= event.name %></h3>
            <p>Período: <%= event.startDate %> a <%= event.endDate %></p>
            <p>Vagas: <%= event.capacity %></p>
            <p>Valor: <%= event.price %></p>
            <a href="/activity/<%= event.id %>">Detalhes</a>
            <a href="/activity/<%= event.id %>/register">Inscrever-se</a>
        </article>
<% } %>
    </main>
</section>