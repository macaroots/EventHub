<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EventHub</title>
    <% if (locals.isAuthPage) { %>
        <link rel="stylesheet" href="/css/auth.css">
    <% } else { %>
        <link rel="stylesheet" href="/css/style.css">
    <% } %>
</head>
<body class="<%= locals.isAuthPage ? 'auth-body' : '' %>">
<% if (locals.isAuthPage) { %>
    <div class="auth-wrapper">
        <aside class="auth-sidebar">
            <div class="brand-header">
                <div class="brand-logo">
                    <span class="logo-box">E</span>
                    <span class="logo-text">EventHub</span>
                </div>
            </div>

            <div class="sidebar-hero">
                <span class="tagline-badge">EVENTOS SEM COMPLICAÇÃO</span>
                <h1 class="hero-title">Organize, participe e conecte-se.</h1>
                <p class="hero-desc">Tudo o que você precisa para viver grandes experiências em um só lugar.</p>
            </div>

            <footer class="sidebar-footer">
                <p>&copy; <%= new Date().getFullYear() %> EventHub. Todos os direitos reservados.</p>
            </footer>
        </aside>

        <main class="auth-main">
            <div class="auth-container">
                <% if (locals.error) { %>
                    <div class="auth-alert error">
                        <%= error %>
                    </div>
                <% } %>
                <%- body -%>
            </div>
        </main>
    </div>
<% } else { %>
    <h1>EventHub</h1>
    <nav>
        <a href="/">Início</a>
<% if (locals.user) { %>
        <a href="/registrations">Minhas inscrições</a>
        <a href="/organizers/events">Meus eventos</a>
        <form method="post" action="/auth/logout" style="display:inline"><button><%= user.username %>: sair</button></form>
<% } else { %>
        <a href="/auth/register">Cadastrar-se</a>
        <a href="/auth/login">Login</a>
<% } %>
    </nav>
    <main>
        <% if (locals.error) { %><p class="error"><%= error %></p><% } %>
        <%- body -%>
    </main>
<% } %>
</body>
</html>
