<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EventHub</title>
    <% if (locals.isAuthPage) { %>
        <link rel="stylesheet" href="/css/auth.css">
    <% } else { %>
        <link rel="stylesheet" href="/css/style.css">
    <% } %>
</head>
<body class="<%= locals.isAuthPage ? 'auth-body' : '' %>">
<% if (locals.isAuthPage) { %>
    <div class="auth-wrapper">
        <aside class="auth-sidebar">
            <div class="brand-header">
                <div class="brand-logo">
                    <span class="logo-box">E</span>
                    <span class="logo-text">EventHub</span>
                </div>
            </div>

            <div class="sidebar-hero">
                <span class="tagline-badge">EVENTOS SEM COMPLICAÇÃO</span>
                <h1 class="hero-title">Organize, participe e conecte-se.</h1>
                <p class="hero-desc">Tudo o que você precisa para viver grandes experiências em um só lugar.</p>
            </div>

            <footer class="sidebar-footer">
                <p>&copy; <%= new Date().getFullYear() %> EventHub. Todos os direitos reservados.</p>
            </footer>
        </aside>

        <main class="auth-main">
            <div class="auth-container">
                <% if (locals.error) { %>
                    <div class="auth-alert error">
                        <%= error %>
                    </div>
                <% } %>
                <%- body -%>
            </div>
        </main>
    </div>
<% } else { %>
    <!-- Topbar Padrão do Protótipo -->
    <header class="app-header">
        <div class="header-container">
            <a href="/" class="header-brand">
                <span class="brand-icon">E</span>
                <span class="brand-title">EventHub</span>
            </a>

            <nav class="header-nav">
                <a href="/" class="nav-link">Eventos</a>
                <% if (locals.user) { %>
                <a href="/registrations" class="nav-link">Minhas inscrições</a>
                <a href="/organizers/events" class="nav-link">Gestão</a>

                <div class="user-profile-pill">
                        <div class="user-avatar">
                            <%= (user.name || user.username || user.email || 'U').slice(0, 2).toUpperCase() %>
                        </div>
                        <div class="user-info">
                            <span class="user-name"><%= user.name || user.username || 'Usuário' %></span>
                            <span class="user-email"><%= user.email || user.username || '' %></span>
                        </div>
                        <form method="post" action="/auth/logout" style="margin: 0; display: inline;">
                            <button class="btn-logout" title="Sair" type="submit">
                                ➔
                            </button>
                        </form>
                    </div>
                <% } else { %>
                    <a href="/auth/login" class="nav-link">Entrar</a>
                    <a href="/auth/register" class="nav-btn-primary">Criar conta</a>
                <% } %>
            </nav>
        </div>
    </header>

    <main class="main-wrapper <%= locals.user ? 'authenticated-layout' : '' %>">
        <% if (locals.user) { %>
            <aside class="dashboard-sidebar">
                <span class="sidebar-heading">GESTÃO UNIFICADA</span>
                <ul class="sidebar-menu">
    <li class="sidebar-item <%= currentPath.startsWith('/organizers/events') ? 'active' : '' %>">
        <a href="/organizers/events">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2"/>
                <line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/>
                <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
            Eventos
        </a>
    </li>

    <li class="sidebar-item <%= currentPath.startsWith('/registrations') ? 'active' : '' %>">
        <a href="/registrations">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
            Inscrições
        </a>
    </li>

    <li class="sidebar-item">
        <a href="#checkin">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="5" y="2" width="14" height="20" rx="2"/>
                <path d="M12 18h.01"/>
            </svg>
            Check-in
        </a>
    </li>

    <li class="sidebar-item">
        <a href="#pagamentos">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="1" y="4" width="22" height="16" rx="2"/>
                <line x1="1" y1="10" x2="23" y2="10"/>
            </svg>
            Pagamentos
        </a>
    </li>

    <li class="sidebar-item">
        <a href="#comunicacoes">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
            </svg>
            Comunicações
        </a>
    </li>

    <li class="sidebar-item <%= currentPath.startsWith('/certificates') ? 'active' : '' %>">
        <a href="/certificates">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 10 12 5 2 10l10 5 10-5z"/>
                <path d="M6 12v5c3 3 9 3 12 0v-5"/>
            </svg>
            Certificados
        </a>
    </li>

</ul>

            </aside>
        <% } %>
        <div class="main-content">
        <% if (locals.success) { %>
            <div class="container" style="padding-bottom: 0;">
                <div class="alert-box alert-success">
                    <span>✓</span>
                    <div><%= success %></div>
                </div>
            </div>
        <% } %>
        <% if (locals.error) { %>
            <div class="container" style="padding-bottom: 0;">
                <div class="alert-box alert-error">
                    <div><%= error %></div>
                </div>
            </div>
        <% } %>

        <%- body -%>
        </div>
    </main>

    <!-- Footer Padrão do Protótipo -->
    <footer class="app-footer">
        <div class="footer-container">
            <div class="footer-brand">EventHub</div>
            <div>Eventos que conectam pessoas e ideias.</div>
            <div>&copy; <%= new Date().getFullYear() %> EventHub</div>
        </div>
    </footer>
<% } %>
</body>
</html>
