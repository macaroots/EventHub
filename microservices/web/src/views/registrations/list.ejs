<section>
    <h2>Minhas inscrições</h2>
<% if (!registrations.length) { %>
    <p>Nenhuma inscrição. <a href="/">Ver eventos</a></p>
<% } else { %>
    <table>
        <tr><th>Evento</th><th>Atividade</th><th>Status</th></tr>
<% for (const r of registrations) { %>
        <tr>
            <td><%= r.event?.name ?? '' %></td>
            <td><a href="/registrations/<%= r.id %>"><%= r.activity?.name ?? r.activityId %></a></td>
            <td><%- include('status', { status: r.status }) %></td>
        </tr>
<% } %>
    </table>
<% } %>
</section>
