<div class="container registration-page">
    <div class="events-section-header">
        <div>
            <h1 class="section-title">Minhas inscrições</h1>
            <p class="section-subtitle">Acompanhe suas inscrições em atividades e eventos.</p>
        </div>
        <a href="/" class="btn-secondary registration-page-action">Ver mais eventos</a>
    </div>

    <% if (!registrations.length) { %>
        <div class="data-panel registration-empty">
            <div class="registration-empty-icon" aria-hidden="true">✓</div>
            <p>Você ainda não possui nenhuma inscrição.</p>
            <a href="/" class="btn-primary">Explorar eventos abertos</a>
        </div>
    <% } else { %>
        <div class="data-panel">
            <table class="hub-table">
                <thead>
                    <tr>
                        <th>Evento</th>
                        <th>Atividade</th>
                        <th>Status</th>
                        <th>Certificado</th>
                        <th class="registration-actions-heading">Detalhes</th>
                    </tr>
                </thead>
                <tbody>
                    <% const certified = new Set(registrations.filter(r => r.event?.status == 'ended' && r.attendance).map(r => r.event.id)); %>
                    <% for (const r of registrations) { %>
                        <tr>
                            <td data-label="Evento"><strong><%= r.event?.name ?? 'Evento' %></strong></td>
                            <td data-label="Atividade"><%= r.activity?.name ?? r.activityId %></td>
                            <td data-label="Status">
                                <span class="status-pill status-<%= r.status %>">
                                    <%- include('status', { status: r.status }) %>
                                </span>
                            </td>
                            <td data-label="Certificado">
                                <% if (r.event?.status == 'ended') { %>
                                    <span style="font-size: 0.85rem; color: #16a34a; font-weight: 600;">
                                        <%= certified.has(r.event.id) ? '✓ Solicitado' : 'Sem presença' %>
                                    </span>
                                <% } else { %>
                                    <span style="color: #94a3b8; font-size: 0.85rem;">Em andamento</span>
                                <% } %>
                            </td>
                            <td data-label="Detalhes" class="registration-actions">
                                <a href="/registrations/<%= r.id %>" class="btn-secondary">Ver detalhes</a>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>
