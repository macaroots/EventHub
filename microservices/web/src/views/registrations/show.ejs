<% const pending = registration.requirements.filter(r => !r.fulfilled); %>
<div class="page-container page-narrow registration-detail-page">
<p class="breadcrumb"><a href="/registrations">Minhas inscrições</a> <span>›</span> Detalhes da inscrição</p>
<section class="page-heading">
    <div class="registration-detail-title">
        <div>
            <span class="eyebrow">MINHA INSCRIÇÃO</span>
            <h1>Detalhes da inscrição</h1>
        </div>
        <span class="status-pill status-<%= registration.status %>"><%- include('status', { status: registration.status }) %></span>
    </div>
    <p class="muted">
        <% if (registration.event) { %>Evento: <a href="/events/<%= registration.event.id %>"><%= registration.event.name %></a>.<% } %>
        Atividade: <%= registration.activity?.name ?? registration.activityId %>.
    </p>
</section>
<section class="registration-detail-card">
<% const ended = registration.event?.status == 'ended'; %>
<% if (ended) { %>
    <p class="notice notice-info"><%= registration.attendance ? 'Evento encerrado. Certificado do evento solicitado, com esta atividade.' : 'Evento encerrado. Sem presença nesta atividade: ela não entra no certificado.' %></p>
<% } %>
<% if (registration.status == 'confirmed') { %>
    <p class="notice notice-success"><strong>Inscrição confirmada!</strong> Sua participação está garantida.</p>
<% if (registration.attendance) { %>
    <div class="attendance-confirmation">
        <span class="attendance-confirmation-icon" aria-hidden="true">✓</span>
        <div><strong>Presença registrada</strong><span>Confirmada em <%= dateTime(registration.attendance.checkedInAt) %></span></div>
    </div>
<% } else if (!ended) { %>
    <form id="registrar-presenca" class="checkin-form" method="post" action="/activities/<%= registration.activityId %>/checkin">
        <input type="hidden" name="registrationId" value="<%= registration.id %>">
        <label for="attendance-code"><span>Código de presença</span><input id="attendance-code" name="code" required autocomplete="off" autocapitalize="characters" size="8" placeholder="Digite o código"></label>
        <button class="btn-primary">Registrar presença</button>
    </form>
<% } %>
<% } else if (registration.status == 'canceled') { %>
    <p class="notice notice-error">Motivo: <%= registration.reasons.join('; ') %></p>
<% } else { %>
<% if (registration.status == 'waitlisted') { %>
    <p>Sem vaga no momento: você está na fila de espera. Sua posição: <strong id="waitlist-position" data-registration-id="<%= registration.id %>"><%= registration.waitlistPosition %></strong>.</p>
    <p><small>Esta página se atualiza sozinha. Quando abrir uma vaga, você será levado ao próximo passo.</small></p>
    <noscript><meta http-equiv="refresh" content="15"></noscript>
    <script type="module">
        import { watchRegistration } from '/js/watch-registration.js';
        const position = document.getElementById('waitlist-position');
        watchRegistration(position.dataset.registrationId, ({ waitlistPosition, next }) => {
            if (next) location.href = next;
            else position.textContent = waitlistPosition;
        });
    </script>
<% } %>
<% if (registration.status == 'awaiting_payment') { %>
    <div class="registration-purchase">
        <div><strong>Sua vaga está reservada</strong><p>Continue para o pagamento de <%= registration.payment.amount.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %> para confirmar a inscrição.</p></div>
        <a class="btn-primary" href="/payments/<%= encodeURIComponent(registration.payment.id) %>">Continuar compra <span aria-hidden="true">→</span></a>
    </div>
<% } %>
<% if (pending.length) { %>
    <p class="section-label">Pendências</p>
    <ul>
<% for (const r of pending) { %>
        <li><%- include('requirement', { requirement: r }) %>: aguardando a organização</li>
<% } %>
    </ul>
<% } %>
    <% if (registration.status != 'awaiting_payment') { %><p><a class="btn-secondary" href="">Atualizar situação</a></p><% } %>
<% } %>
<% if (registration.status != 'canceled' && !ended) { %>
    <form method="post" action="/registrations/<%= registration.id %>/cancel" onsubmit="return confirm('Cancelar a inscrição?')">
        <button class="btn-danger">Cancelar inscrição</button>
    </form>
<% } %>
<% if (registration.userId == user.sub && registration.event?.id) { %>
    <section class="data-panel registration-certificate" aria-labelledby="registration-certificate-title">
        <h2 id="registration-certificate-title">Certificado do evento</h2>
        <p class="muted">O certificado reúne as atividades em que você registrou presença e fica disponível após o encerramento do evento.</p>
        <div class="registration-certificate-actions">
            <form method="post" action="/registrations/<%= encodeURIComponent(registration.id) %>/certificate">
                <button class="btn-primary" type="submit">Gerar certificado</button>
            </form>
            <a href="/certificates">Ver todos os meus certificados <span aria-hidden="true">→</span></a>
        </div>
    </section>
<% } %>
</section>
</div>
