<% const pending = registration.requirements.filter(r => !r.fulfilled); %>
<p><a href="/registrations">← Minhas inscrições</a></p>
<section>
    <h2>Inscrição <small>(<%- include('status', { status: registration.status }) %>)</small></h2>
    <p>
        <% if (registration.event) { %>Evento: <a href="/events/<%= registration.event.id %>"><%= registration.event.name %></a>.<% } %>
        Atividade: <%= registration.activity?.name ?? registration.activityId %>.
    </p>
<% if (registration.status == 'confirmed') { %>
    <p>Inscrição confirmada!</p>
<% if (registration.attendance) { %>
    <p>Presença registrada em <%= dateTime(registration.attendance.checkedInAt) %>.</p>
<% } else { %>
    <form method="post" action="/activities/<%= registration.activityId %>/checkin">
        <input type="hidden" name="registrationId" value="<%= registration.id %>">
        <label><span>Check-in: código mostrado na sala</span><input name="code" required autocomplete="off" autocapitalize="characters" size="8"></label>
        <button>Registrar presença</button>
    </form>
<% } %>
<% } else if (registration.status == 'canceled') { %>
    <p>Motivo: <%= registration.reasons.join('; ') %></p>
<% } else { %>
<% if (registration.status == 'waitlisted') { %>
    <p>Sem vaga no momento: você está na fila de espera. Sua posição: <strong id="waitlist-position" data-registration-id="<%= registration.id %>"><%= registration.waitlistPosition %></strong>.</p>
    <p><small>Esta página se atualiza sozinha. Quando abrir uma vaga, você será levado ao próximo passo.</small></p>
    <noscript><meta http-equiv="refresh" content="15"></noscript>
    <script type="module">
        import { watchRegistration } from '/js/watch-registration.js';
        const position = document.getElementById('waitlist-position');
        watchRegistration(position.dataset.registrationId, ({ waitlistPosition, next }) => {
            if (next) location.href = next;
            else position.textContent = waitlistPosition;
        });
    </script>
<% } %>
<% if (registration.status == 'awaiting_payment') { %>
    <p>Vaga reservada. <a href="/payments/<%= registration.payment.id %>">Pagar R$ <%= registration.payment.amount.toFixed(2) %></a> para confirmar.</p>
<% } %>
<% if (pending.length) { %>
    <p>Pendências:</p>
    <ul>
<% for (const r of pending) { %>
        <li><%- include('requirement', { requirement: r }) %>: aguardando a organização</li>
<% } %>
    </ul>
<% } %>
    <p><a href="">Atualizar</a></p>
<% } %>
<% if (registration.status != 'canceled') { %>
    <form method="post" action="/registrations/<%= registration.id %>/cancel" onsubmit="return confirm('Cancelar a inscrição?')">
        <button>Cancelar inscrição</button>
    </form>
<% } %>
</section>
