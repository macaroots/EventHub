<form action="/auth/login" method="post">
    <input type="hidden" name="next" value="<%= locals.next ?? '' %>">
    <label>
        <span>E-mail</span>
        <input name="username">
    </label>
    <label>
        <span>Password</span>
        <input name="password" type="password">
    </label>
    <button>Login</button>
</form>