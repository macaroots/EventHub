<form action="/auth/register" method="post">
    <label>
        <span>Name</span>
        <input name="name">
    </label>
    <label>
        <span>E-mail</span>
        <input name="email">
    </label>
    <label>
        <span>Password</span>
        <input name="password" type="password">
    </label>
    <label>
        <span>Confirm password</span>
        <input name="confirmation" type="password">
    </label>
    <button>Login</button>
</form>